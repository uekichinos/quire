{
  "name": "@uekichinos/quire",
  "version": "0.1.0",
  "description": "Small, dependency-light .xlsx writer for Node and the browser. Worksheets, typed cells, styles, number formats, merged cells — no OOXML reader, no legacy bloat.",
  "keywords": [
    "uekichinos",
    "quire",
    "xlsx",
    "excel",
    "spreadsheet",
    "xlsx-writer",
    "ooxml",
    "export",
    "workbook",
    "zero-dependency"
  ],
  "author": {
    "name": "uekichinos",
    "url": "https://www.npmjs.com/~uekichinos"
  },
  "homepage": "https://github.com/uekichinos/quire#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uekichinos/quire.git"
  },
  "bugs": {
    "url": "https://github.com/uekichinos/quire/issues"
  },
  "license": "MIT",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/uekichinos"
  },
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist/*.js",
    "dist/*.cjs",
    "dist/*.d.ts",
    "dist/*.d.cts",
    "dist/*.global.js",
    "CHANGELOG.md",
    "SECURITY.md",
    "NOTICE",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm build && pnpm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "vitest": "^3.2.4"
  }
}
